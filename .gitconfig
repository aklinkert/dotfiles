# Machine-local, untracked overrides (host-specific credentials, work config).
[include]
	path = ~/.gitconfig.local
[push]
	default = simple
	followTags = true
[core]
	excludesfile = ~/.gitignore_global
	mergeoptions = --no-edit
	autocrlf = false
	editor = code -w
[filter "lfs"]
	clean = git lfs clean %f
	smudge = git lfs smudge %f
	required = true
[hub]
	protocol = ssh
[status]
	submoduleSummary = true
[diff]
	tool = vscode
[difftool]
	prompt = false
[merge]
	tool = vscode
[mergetool]
	prompt = false
	keepBackup = false
[commit]
	gpgsign = true
[credential]
	helper = store
[push]
	autoSetupRemote = true
[pull]
	rebase = true
[pull]
	ff = only
[init]
	defaultBranch = main
[checkout]
	defaultRemote = origin
[advice]
	skippedCherryPicks = false
[lfs]
	access = basic
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[difftool "vscode"]
	cmd = code --wait --diff \"$LOCAL\" \"$REMOTE\"
	trustExitCode = true
[mergetool "vscode"]
	cmd = code --wait --merge \"$REMOTE\" \"$LOCAL\" \"$BASE\" \"$MERGED\"
	trustExitCode = true
